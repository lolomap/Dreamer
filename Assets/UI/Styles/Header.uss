.header {
    background-color: white;
    border-radius: 0 0 16px 16px;
    align-items: center;
    justify-content: center;
    
    font-size: 120px;
    -unity-font-definition: url("/Assets/Fonts/Factor A-Extrabold-Web.ttf");
    -unity-font-style: bold;
    /*visibility: hidden;*/
}

.shadow-header {
    /*background-color: rgb(0, 0, 0);*/
    border-radius: 16px;
    width: 100%;
    height: 100%;
}
