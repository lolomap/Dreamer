#toggle-mode {
    height: 128px;
    font-size: 36px;
}

.topic-grid {
    flex-direction: row;
    justify-content: center;
    align-content: center;
    flex-wrap: wrap;
    margin: -8px;
}

.topic-grid > * {
    width: 30%;             /* Базовая ширина ~1/3 родителя */
    flex-grow: 0;               /* Захват доп. пространства */
    flex-shrink: 0;             /* Запрет на сжатие меньше 33.333% */
    margin: 8px;               /* Имитация отступов */
}