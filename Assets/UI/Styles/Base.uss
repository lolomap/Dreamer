.root {
    height: 100%;
    margin: 16px;
    padding: 16px;
}

.center {
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.panel-block {
    background-color: white;
    border-radius: 32px;
}

.panel-element {
    background-color: white;
    border-radius: 16px;
}

.grid {
    flex-direction: row;
    justify-content: center;
    align-content: center;
    flex-wrap: wrap;
}

.grid > * {
    margin: 8px;
}
